# Real dummy-account credentials for the integration test suite.
# Copy to .env.test.local (gitignored) and fill in.
#
# Every dummy account shares one password, so it is stored once. Emails are a
# comma-separated pool: suites take as many as they need, and the post fixture
# walks the pool to find an account whose daily entry slot is still free
# (posts has unique(user_id, local_date)). Two accounts is the minimum.
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_EMAILS=
